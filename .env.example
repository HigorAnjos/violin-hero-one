# Copie para .env.local e preencha.
# Só as variáveis do bloco "Site" vão para o navegador (lista PUBLIC_ENV no vite.config.ts);
# para expor outra, inclua o nome lá — e nunca um segredo.

# ---------------------------------------------------------------------------
# Site (build do front) — estas são as que vão na hospedagem
# ---------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_ID].supabase.co
# Chave pública anon/publishable
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=violinhero

# ---------------------------------------------------------------------------
# Só na máquina de quem desenvolve (scripts/ e CLI) — nunca no build do site
# ---------------------------------------------------------------------------
# Conexão direta ao Postgres (migrações e testes de banco)
DATABASE_URL=postgresql://postgres:[SENHA]@db.[PROJECT_ID].supabase.co:5432/postgres

# Supabase CLI: publicar Edge Functions e segredos (token em supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=[PROJECT_ID]
